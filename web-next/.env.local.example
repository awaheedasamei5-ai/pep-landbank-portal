# Copy this file to .env.local (already gitignored) and fill in whichever
# keys you've signed up for. Every integration in the app checks these via
# shared/lib/env.ts and degrades gracefully if a key is missing -- nothing
# breaks or blocks on any of these being unset.

# Resend -- transactional email (quotations, contracts, receipts).
# Free tier: 3,000 emails/month, 100/day, forever free, one verified domain.
# Sign up: https://resend.com/signup -- create an API key under
# Dashboard > API Keys, then paste it below.
VITE_RESEND_API_KEY=

# Mapbox -- plot-location maps + geocoding on Plot Inventory/Site Visits.
# Free tier: 50,000 web map loads/month + 100,000 geocoding requests/month,
# no credit card required to start.
# Sign up: https://account.mapbox.com/auth/signup -- copy your "Default
# public token" from the account dashboard.
VITE_MAPBOX_TOKEN=

# Sentry -- production error tracking (catches real crashes automatically
# instead of relying on someone spotting a broken screen).
# Free "Developer" tier: 5,000 events/month, 1 user, 30-day retention.
# Sign up: https://sentry.io/signup/ -- create a React project, copy the
# DSN from Settings > Projects > (your project) > Client Keys (DSN).
VITE_SENTRY_DSN=

# Arkesel -- Ghana-focused SMS (OTP, payment confirmations). NOT free --
# there is no real ongoing free SMS API anywhere (carriers charge per
# message everywhere), but Arkesel is the cheapest reliable Ghana option
# (from GHS 0.02/SMS). Only wire this up when ready to pay for real SMS
# volume -- everything else in this app works without it.
# Sign up: https://arkesel.com -- API key is under Dashboard > API.
VITE_ARKESEL_API_KEY=

# Supabase -- the actual backend. Point this at the STAGING project
# ("PALMSTEAD", an empty schema-clone) for all development -- never at the
# real production project ("PEP LANDBANK LTD") except at deliberate,
# reviewed cutover time. The anon key is safe to expose client-side by
# design (RLS is the real access boundary, not key secrecy).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
